!Sample_title = LUM0183: 9086807
!Sample_geo_accession = GSM3891044
!Sample_status = Public on Jun 13 2020
!Sample_submission_date = Jun 14 2019
!Sample_last_update_date = Oct 28 2020
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = blood globin reduced
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = genotype/variation: WT
!Sample_characteristics_ch1 = tissue: blood
!Sample_characteristics_ch1 = mouse id: 9086807
!Sample_characteristics_ch1 = sample type: blood globin reduced
!Sample_characteristics_ch1 = group: WT
!Sample_characteristics_ch1 = origin: total RNA
!Sample_characteristics_ch1 = total ng rna: globin reduced
!Sample_characteristics_ch1 = week: 6
!Sample_characteristics_ch1 = weight before fasting (g): 24.06
!Sample_characteristics_ch1 = weight after fasting (g): 22.97
!Sample_characteristics_ch1 = time food removed: 9:15
!Sample_characteristics_ch1 = time collection: 13:55
!Sample_growth_protocol_ch1 = Mice were fasted for 4-6 hours with access to water before collecing the blood sample. Blood was collected at 6, 12, 18, 24 and 30 weeks of age. About 100μl of blood were collected frmo the tail into RNA protecting tubes. Mice were anaesthetised during blood collection with 2% isoflurane in oxygen and a solution of lidocaine was applied on the tail after the procedure. Mice were sacrificed at 30 weeks of age when the tibialis anterior muscle was also collected.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was purified from blood using the Rneasy Protect Animal blood kit and the globin mRNA content was reduced using the globin clear kit. Muscle RNA was purified with Tripure reagent.
!Sample_extract_protocol_ch1 = Trueseq v2 paired end sequencing
!Sample_description = internal code: LUM0183
!Sample_data_processing = Data were aligned with STAR
!Sample_data_processing = Expression was quantified with cufflinks
